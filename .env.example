# URL base do serviço FastAPI na VPS (sem o slash final).
AUTH_SERVICE_URL=http://localhost:8001/api

# Segredo privado longo para assinar a sessão HttpOnly do BFF.
AUTH_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# Em produção deve ser true. Use false somente no desenvolvimento local.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
