APP_NAME=wired-links-api
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wired_links

# Credenciais da aplicação OAuth criada no Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Esta URL precisa estar cadastrada no Discord e apontar para o callback do frontend.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback
DISCORD_API_URL=https://discord.com/api

# IDs Discord separados por vírgula. Apenas estes usuários recebem role admin.
DISCORD_ADMIN_IDS=395249144677007370

# Origens e callbacks permitidos; não use wildcard com credenciais.
ALLOWED_RETURN_URLS=http://localhost:5173/api/auth/callback
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=604800
